{
  "name": "@conway/automaton",
  "version": "0.2.1",
  "description": "Conway Automaton - Sovereign AI Agent Runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    }
  },
  "bin": {
    "automaton": "dist/index.js",
    "conway-automaton": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felfel-aly/automaton.git"
  },
  "homepage": "https://github.com/felfel-aly/automaton",
  "keywords": [
    "autonomous-agent",
    "sovereign-ai",
    "web4",
    "conway",
    "self-replicating"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "tsc && pnpm -r build",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run --grep 'security|injection|policy'",
    "test:financial": "vitest run --grep 'financial|spend|treasury'",
    "test:ci": "vitest run --reporter=verbose",
    "overwatch:status": "bash scripts/overwatch-status.sh",
    "clean": "rm -rf dist && pnpm -r clean"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "chalk": "^5.6.2",
    "cron-parser": "^4.9.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.49.0",
    "ora": "^8.2.0",
    "siwe": "^2.3.2",
    "tweetnacl": "^1.0.3",
    "ulid": "^2.4.0",
    "viem": "^2.57.16",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "ws@8.17.1": "8.22.1"
    }
  }
}
